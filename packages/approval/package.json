{
  "name": "agent-latch-approval",
  "version": "0.1.0",
  "description": "Companion to latch: bind human approval to the exact tool payload — deny on drift",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "demo": "tsc -p tsconfig.json && node --import tsx demo/run.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "ai-agent",
    "approval",
    "human-in-the-loop",
    "integrity",
    "tool-use",
    "latch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronDai23/agent-latch.git",
    "directory": "packages/approval"
  },
  "homepage": "https://github.com/AaronDai23/agent-latch/tree/main/packages/approval#readme",
  "bugs": {
    "url": "https://github.com/AaronDai23/agent-latch/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
